# Production-only organization administration. Copy into an ignored local env file
# or configure Vercel Production after reviewing docs/organization-admin.md.
VERCEL_ENV=production
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_AUTHORIZED_PARTIES=https://www.exeterbiosymposium.page
CLERK_TEAM_ORG_ID=
CLERK_PENDING_ORG_ID=
CLERK_ACCEPTED_ORG_ID=
EBS_ORG_INSTANCE_ID=
# Existing private Neon connection; EBS_DRIVE_DATABASE_URL is also supported.
EBS_ORG_DATABASE_URL=
EBS_ORG_POOLS_ENABLED=false
EBS_ORG_ROLLOVER_ENABLED=false
# Website content editor (docs/website-content.md). Keep false until scripts/sql/page-content.sql
# has been applied; until then readers receive the built-in page content and editing is unavailable.
EBS_CONTENT_ENABLED=false
