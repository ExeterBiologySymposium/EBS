{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "exeterbiosymposium\\.(?:page|vercel\\.app)"
        }
      ],
      "destination": "https://www.exeterbiosymposium.page/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/volunteer-signup.html",
      "destination": "/judges.html",
      "permanent": true
    }
  ]
}
