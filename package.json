{
  "name": "ebs",
  "version": "1.0.0",
  "description": "Exeter Biology Symposium website",
  "scripts": {
    "test:participant-folders": "node scripts/check-participant-folders.mjs && node scripts/check-drive-adapter.mjs && node scripts/check-owner-oauth.mjs && node scripts/check-folder-store.mjs && node scripts/check-folder-ui.mjs",
    "test:participant-folders-browser": "node scripts/browser-participant-folders.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "check": "npm run typecheck",
    "test:navigation-browser": "node scripts/browser-navigation.mjs",
    "test:navigation": "node scripts/check-navigation.mjs",
    "test:contact": "node scripts/check-contact.mjs",
    "test:auth": "node scripts/check-auth.mjs",
    "test:clerk-config": "node scripts/check-clerk-config.mjs",
    "seo:update": "node scripts/update-seo.mjs",
    "test:access": "node scripts/check-access.mjs",
    "test:member-ui": "node scripts/check-member-ui.mjs",
    "test:access-build": "node scripts/check-access-build.mjs",
    "test:vercel-runtime": "node scripts/check-vercel-runtime.mjs",
    "test:member-pages": "node scripts/check-member-pages.mjs",
    "test:member-pages-browser": "node scripts/browser-member-pages.mjs",
    "test:owner-authorization": "node scripts/check-owner-authorization.mjs",
    "authorize:drive": "node --env-file=.env.google-drive.local scripts/authorize-google-drive.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExeterBiologySymposium/EBS.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ExeterBiologySymposium/EBS/issues"
  },
  "homepage": "https://github.com/ExeterBiologySymposium/EBS#readme",
  "dependencies": {
    "@clerk/backend": "^3.25.0",
    "@clerk/react": "^6.17.8",
    "@neondatabase/serverless": "^1.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.10.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "google-auth-library": "^11.3.2",
    "lucide-react": "^1.41.0",
    "motion": "^13.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@types/node": "^26.4.1"
  },
  "type": "module"
}
