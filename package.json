{
  "name": "ebs",
  "version": "1.0.0",
  "description": "Exeter Biology Symposium website",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "check": "npm run typecheck",
    "seo:update": "node scripts/update-seo.mjs",
    "authorize:drive": "node --env-file=.env.google-drive.local scripts/authorize-google-drive.mjs",
    "test:org-admin": "node --test scripts/org-rollover.test.mjs scripts/org-api.test.mjs scripts/org-store.test.mjs && node scripts/org-ui.test.mjs",
    "orgs:bootstrap": "node scripts/org-bootstrap.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExeterBiologySymposium/EBS.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ExeterBiologySymposium/EBS/issues"
  },
  "homepage": "https://github.com/ExeterBiologySymposium/EBS#readme",
  "dependencies": {
    "@clerk/backend": "^3.25.0",
    "@clerk/react": "^6.17.8",
    "@neondatabase/serverless": "^1.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.10.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "google-auth-library": "^11.3.2",
    "lucide-react": "^1.41.0",
    "motion": "^13.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.1"
  },
  "type": "module"
}
